<?xml version="1.0" encoding="utf-8"?>
<!-- Familienplaner "Heute (Standard)": moderne Text-Kachel mit Icons – nur RemoteViews-erlaubte Views (LinearLayout/TextView/ImageView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_std"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_standard_name"
            android:src="@drawable/ic_stat_family" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Familienplaner"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_ic_shop"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/widget_standard_shop"
            android:src="@drawable/ic_shortcut_cart" />

        <TextView
            android:id="@+id/widget_shop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_spacer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/widget_ic_tasks"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/widget_standard_tasks"
            android:src="@drawable/ic_shortcut_task" />

        <TextView
            android:id="@+id/widget_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
