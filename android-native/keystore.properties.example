# In keystore.properties umbenennen und ausfüllen, damit Release-APKs signiert werden.
# Gleiches Keystore wie android/ verwenden oder eigenes erzeugen:
#   keytool -genkeypair -v -keystore familienplaner.keystore -alias familienplaner \
#     -keyalg RSA -keysize 2048 -validity 10000 -storepass <passwort> -dname "CN=Familienplaner"
storeFile=../android/familienplaner.keystore
storePassword=<passwort>
keyAlias=familienplaner
keyPassword=<passwort>
